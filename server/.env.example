# Settings for running the API on your own PC with "npm start" / "npm run dev" (no Docker).
# Copy to server/.env and fill in. server/.env is git-ignored: never commit real values.
# (For Docker or a VPS use the .env file in the project root instead: see ../.env.example)

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/anaa_nutricare
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# E-mail. Leave SMTP_HOST empty and e-mails are only recorded as SKIPPED instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Anaa Nutricare <no-reply@example.com>"

# Razorpay: use TEST keys (rzp_test_...) while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

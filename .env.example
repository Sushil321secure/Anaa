# Copy to .env next to docker-compose.yml and fill in. .env is git-ignored. Never commit real values.

# Public address. On a VPS: your domain (DNS A record -> VPS IP). To try it on your own PC: localhost
DOMAIN=example.com
# Only for plain-HTTP local testing (DOMAIN=localhost):
# CLIENT_ORIGIN=http://localhost
# COOKIE_SECURE=false

# Laptop only (Windows/Mac): use empty local folders instead of the VPS paths. Leave these two lines out on a VPS.
# LETSENCRYPT_DIR=./local-certs
# CERTBOT_WEBROOT=./local-certs

# MongoDB (long random passwords: openssl rand -hex 24)
MONGO_ROOT_USER=anaa_admin
MONGO_ROOT_PASSWORD=

# API
JWT_SECRET=
JWT_EXPIRES_IN=7d

# E-mail (booking confirmations, reminders, password reset). Without SMTP_HOST, e-mails are only logged as skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Anaa Nutricare <no-reply@example.com>"

# Razorpay: LIVE keys in production (rzp_live_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
